# ============================================================
# CustomerHub — Development Environment Variables
# ------------------------------------------------------------
# Copy this file to backend/.env and fill in local values.
# Run the dev database with: docker compose up -d
# ============================================================

# ── Runtime mode ─────────────────────────────────────────────
ENV=development

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────
# Matches the dev MariaDB container in docker-compose.yml (host port 3307)
DB_URL=mysql+pymysql://helpdesk:helpdesk_pass@127.0.0.1:3307/helpdesk_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# ── Email (set EMAIL_FEATURES_ENABLED=false to skip IMAP/SMTP in dev) ──
EMAIL_FEATURES_ENABLED=false
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=ticket@example.com
IMAP_PASS=replace-me

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=ticket@example.com
SMTP_PASS=replace-me
SMTP_FROM_EMAIL=ticket@example.com
SMTP_FROM_NAME=CustomerHub Dev
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ── Storage ───────────────────────────────────────────────────
# Path relative to where uvicorn is started (backend/)
FILES_ROOT=./files
STORAGE_BACKEND=local

# ── Seed script ───────────────────────────────────────────────
# Password for admin + customer2 accounts created by seed_base.py
SEED_ADMIN_PASSWORD=CHANGE_THIS

# ── Frontend / CORS ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
