ENV=development
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ALGO=HS256
DATABASE_URL=mysql+pymysql://helpdesk:replace-me@localhost:3307/helpdesk_db
DB_URL=mysql+pymysql://helpdesk:replace-me@localhost:3307/helpdesk_db
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
# Public URL of the frontend — used for links in outbound emails
FRONTEND_URL=https://yourdomain.com
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
# REDIS_URL overrides REDIS_HOST/REDIS_PORT/REDIS_PASSWORD when set
#REDIS_URL=redis://127.0.0.1:6380
EMAIL_FEATURES_ENABLED=true
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASS=replace-me
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USER=support@example.com
SMTP_PASS=replace-me
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=WorkDesk Support
ADMIN_NOTIFICATION_EMAIL=admin@example.com
FILES_ROOT=./files
STORAGE_BACKEND=local
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_CHANGE_PASSWORD=5/minute
RATE_LIMIT_TICKET_CREATE=20/minute
RATE_LIMIT_FILE_UPLOAD=10/minute
RATE_LIMIT_ADMIN_EMAIL_POLL=3/minute
