# Runtime
ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8001

# Database - replace locally; never commit a real credential.
DATABASE_URL=mysql+pymysql://helpdesk_user:change_me@127.0.0.1:3306/helpdesk
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://127.0.0.1:6379
PRESENCE_ENABLED=true
PRESENCE_TTL_SECONDS=90
PRESENCE_HEARTBEAT_SECONDS=30
VITE_PRESENCE_HEARTBEAT_SECONDS=30

# Assignment and asynchronous AI routing
AI_FEATURES_ENABLED=false
AI_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
AI_ASSIGNMENT_REEVALUATION_ENABLED=true
AI_ASSIGNMENT_CONFIDENCE_THRESHOLD=0.75
AI_ASSIGNMENT_MIN_SCORE_IMPROVEMENT=8
AI_ASSIGNMENT_MAX_TICKET_AGE_MINUTES=5
AI_ASSIGNMENT_REEVALUATION_MODE=suggest

# SLA reminders
SLA_REPEAT_ALERTS_ENABLED=true
SLA_ALERT_REPEAT_SECONDS=3600

# Optional email
EMAIL_FEATURES_ENABLED=false
LOAD_TEST_MODE=false
ALLOW_LOAD_TEST=false
AI_ENABLED=false
EMAIL_SENDING_ENABLED=false
EMAIL_POLLING_ENABLED=false
GOOGLE_INTEGRATIONS_ENABLED=false
PAYMENT_INTEGRATIONS_ENABLED=false
LOAD_TEST_KEY=
LOAD_TEST_ORG_ID=

IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASS=
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=support@example.com
SMTP_PASS=
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=CustomerHub Support
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# File storage
FILES_ROOT=/absolute/path/to/customerhub/files
STORAGE_BACKEND=local

# Optional integrations
TOKEN_ENCRYPTION_KEY=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8001/api/seo/gsc/callback
GA4_REDIRECT_URI=http://localhost:8001/api/seo/ga4/callback
