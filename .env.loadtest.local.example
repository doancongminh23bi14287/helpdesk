ENV=development
LOAD_TEST_MODE=true
ALLOW_LOAD_TEST=true
LOAD_TEST_KEY=generate-a-local-random-key
LOAD_TEST_ORG_ID=4

LOADTEST_MYSQL_ROOT_PASSWORD=local-only-root-password
LOADTEST_MYSQL_DATABASE=helpdesk_loadtest
LOADTEST_MYSQL_USER=helpdesk_loadtest
LOADTEST_MYSQL_PASSWORD=local-only-password

JWT_SECRET=local-loadtest-secret-at-least-32-characters
AI_FEATURES_ENABLED=false
EMAIL_FEATURES_ENABLED=false
EMAIL_POLLING_ENABLED=false
GOOGLE_INTEGRATIONS_ENABLED=false
PAYMENT_INTEGRATIONS_ENABLED=false

LOAD_TEST_CONFIRM=true
LOAD_TEST_PREFIX=LOADTEST-
LOAD_TEST_TARGET=http://127.0.0.1:8011
