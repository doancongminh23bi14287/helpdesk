# Database (từ Railway MySQL plugin — copy từ Railway dashboard)
DB_URL=mysql+pymysql://user:pass@host:port/railway

# Redis (từ Railway Redis plugin — supports REDIS_URL directly)
REDIS_URL=redis://default:pass@host:port

# JWT
JWT_SECRET=change-this-to-32-char-random-string
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://YOUR_FRONTEND_RAILWAY_URL

# Email
IMAP_HOST=mail.osd.vn
IMAP_PORT=993
IMAP_USER=ticket@osd.vn
IMAP_PASS=YOUR_IMAP_PASSWORD
SMTP_HOST=mail.osd.vn
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=ticket@osd.vn
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=ticket@osd.vn
SMTP_FROM_NAME=OSD Support
ADMIN_NOTIFICATION_EMAIL=admin@osd.vn
EMAIL_FEATURES_ENABLED=true

# AI
AI_FEATURES_ENABLED=true
GROQ_API_KEY=YOUR_GROQ_KEY
AI_MODEL=llama-3.1-8b-instant

# Google Search Console OAuth
GSC_CLIENT_ID=YOUR_GSC_CLIENT_ID
GSC_CLIENT_SECRET=YOUR_GSC_CLIENT_SECRET
GSC_REDIRECT_URI=https://YOUR_BACKEND_RAILWAY_URL/api/seo/gsc/callback
