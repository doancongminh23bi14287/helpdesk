# ============================================================
# CustomerHub — Production Environment Variables
# ------------------------------------------------------------
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to version control.
# ============================================================

# ── Runtime mode ─────────────────────────────────────────────
ENV=production

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-random-64-char-hex-string
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────
# DB_URL is read by the app; the MYSQL_* vars are used by the MariaDB container
DB_URL=mysql+pymysql://helpdesk:CHANGE_PASSWORD@db:3306/helpdesk_db
MYSQL_ROOT_PASSWORD=CHANGE_ROOT_PASSWORD
MYSQL_DATABASE=helpdesk_db
MYSQL_USER=helpdesk
MYSQL_PASSWORD=CHANGE_PASSWORD

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty if Redis has no password (default in docker-compose.prod.yml)
REDIS_PASSWORD=

# ── Email (IMAP inbound) ──────────────────────────────────────
# Set EMAIL_FEATURES_ENABLED=true only after configuring all IMAP/SMTP vars
EMAIL_FEATURES_ENABLED=false
IMAP_HOST=mail.osd.vn
IMAP_PORT=993
IMAP_USER=ticket@osd.vn
IMAP_PASS=CHANGE_IMAP_PASSWORD

# ── Email (SMTP outbound) ─────────────────────────────────────
SMTP_HOST=mail.osd.vn
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=ticket@osd.vn
SMTP_PASS=CHANGE_SMTP_PASSWORD
SMTP_FROM_EMAIL=ticket@osd.vn
SMTP_FROM_NAME=OSD Support
ADMIN_NOTIFICATION_EMAIL=admin@osd.vn

# ── Storage ───────────────────────────────────────────────────
# Absolute path inside the container (maps to files_data volume)
FILES_ROOT=/app/files
STORAGE_BACKEND=local

# ── Frontend / CORS ───────────────────────────────────────────
# Must match the actual public URL — no wildcard in production
FRONTEND_URL=https://customerhub.osd.vn
CORS_ORIGINS=https://customerhub.osd.vn

# ── Seed script ───────────────────────────────────────────────
# Password for admin + customer2 accounts created by seed_base.py
# Only needed when running: python scripts/seed_base.py
SEED_ADMIN_PASSWORD=CHANGE_THIS
